# ┌──────────────────────────────────────────────┐
# │  Fanatec Stock Searcher — Environment Vars   │
# └──────────────────────────────────────────────┘

# REQUIRED: Your Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# REQUIRED: Your Telegram numeric User ID (from @userinfobot)
TELEGRAM_ADMIN_USER_ID=123456789

# OPTIONAL: Target URL (defaults to EU refurbished page)
# FANATEC_URL=https://www.fanatec.com/eu/en/c/certified-refurbished

# OPTIONAL: Check interval in minutes (default: 10)
# CHECK_INTERVAL_MINUTES=10

# OPTIONAL: Database file path (default: products.db in project dir)
# DB_PATH=products.db

# OPTIONAL: Scraper timeout in seconds (default: 30)
# SCRAPER_TIMEOUT=30

# OPTIONAL: Use Playwright only, skip cloudscraper (default: false)
# USE_PLAYWRIGHT_ONLY=false

# OPTIONAL: Log level (default: INFO)
# LOG_LEVEL=INFO
